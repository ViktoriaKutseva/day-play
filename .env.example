# Day-Play Configuration
# Copy this file to .env and fill in your values

# Environment (development/testing/production)
ENVIRONMENT=development

# Application Settings
APP_NAME=day-play
APP_VERSION=0.1.0
APP_DEBUG=True

# Database Configuration
# Development: sqlite:///./data/dev.db
# Testing: sqlite:///:memory:
# Production: postgresql://user:password@localhost/dbname
APP_DATABASE_URL=sqlite:///./data/dev.db

# Logging
APP_LOG_LEVEL=DEBUG

# Production Only (required when ENVIRONMENT=production)
# DATABASE_URL=postgresql://user:password@localhost/day_play
